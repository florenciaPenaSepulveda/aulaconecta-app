{
  "expo": {
    "name": "AulaConecta",
    "slug": "aulaconecta",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1f3a5f"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "cl.aulaconecta.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1f3a5f"
      },
      "package": "cl.aulaconecta.app"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "scheme": "aulaconecta",
    "plugins": [
      "expo-secure-store"
    ]
  }
}
